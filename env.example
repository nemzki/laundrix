# =============================================================================
# Laundrix environment template
# =============================================================================
# 1. Copy this file to ".env" (same folder as run.py) and fill in real values.
# 2. NEVER commit ".env". Only this ".env.example" belongs in Git.
# 3. Generate SECRET_KEY with:
#      python -c "import secrets; print(secrets.token_hex(32))"
# 4. Required to start the app: SECRET_KEY, DB_USER, DB_PASSWORD.
#    Everything else has a safe default. Optional integrations stay OFF until enabled.
# 5. Put comments on their OWN line (as below). Restart Flask/gunicorn after any change.
#
# The values below are safe LOCAL-DEVELOPMENT defaults.
# Production (Render + TiDB) values are shown in the "Production:" notes.
# =============================================================================

# --- App ---------------------------------------------------------------------
# development | production
# Production: production
APP_ENV=development
SECRET_KEY=
# Public base URL. Used for QR tracking links, Google/Didit callbacks and enrollment links.
# Production: your real https:// URL (the app refuses to start in production without https).
APP_BASE_URL=http://127.0.0.1:5000
SESSION_LIFETIME_MINUTES=480
# true when behind Nginx / Cloudflare / Render (so client IP and https are read correctly).
# Production: true
BEHIND_PROXY=false
# Rate-limit counter storage. memory:// is fine for one process.
# Production with several workers: redis://HOST:6379
RATELIMIT_STORAGE_URI=memory://

# --- Database (MySQL locally, TiDB Cloud in production) -----------------------
# Local MySQL:
DB_HOST=localhost
DB_PORT=3306
DB_NAME=laundrix_db
DB_USER=
DB_PASSWORD=
# Production (TiDB Cloud): DB_HOST=<your-cluster>.tidbcloud.com, DB_PORT=4000,
# DB_NAME=<your database>, plus the TLS settings below.

# TLS to the database (REQUIRED for TiDB Cloud; leave DB_SSL_CA empty for local MySQL).
# Use a path that exists on THIS machine, e.g.
#   Windows: C:\path\to\isrgrootx1.pem     Render: /etc/secrets/isrgrootx1.pem
DB_SSL_CA=
DB_SSL_VERIFY_CERT=true
DB_SSL_VERIFY_IDENTITY=true

# --- Google OAuth (https://console.cloud.google.com/apis/credentials) ----------
# Authorized redirect URI to register: <APP_BASE_URL>/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: only allow Google accounts from one domain, e.g. mybusiness.com
GOOGLE_ALLOWED_DOMAIN=
# Allow staff to sign in with Google (the account must already exist; never auto-created).
STAFF_GOOGLE_LOGIN_ALLOWED=true

# --- Administrator password sign-in --------------------------------------------
ADMIN_PASSWORD_LOGIN_ENABLED=true
# Read ONLY by `flask --app run bootstrap-admin` to create the first administrator.
# Choose a strong, unique password. REMOVE INITIAL_ADMIN_PASSWORD once it has been used.
# To give an existing (Google) admin a password instead: flask --app run rotate-admin-password you@example.com
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_EMAIL=

# --- Staff portal: lockout and enrollment --------------------------------------
STAFF_MAX_FAILED_ATTEMPTS=5
STAFF_LOCKOUT_MINUTES=15
STAFF_LOGIN_WINDOW_SECONDS=600
STAFF_ENROLL_TOKEN_HOURS=24

# --- Identity verification: government ID + liveness + face match (Didit) -------
# OFF by default. Turn on only after you have created a Didit application + workflow.
# Setup guide: docs/identity_verification.md   |   Face login: docs/face_login_guide.md
# Production (if you use it): true
IDV_ENABLED=false
IDV_PROVIDER=didit
# Didit Console > API & Webhooks (keep secret; backend only)
DIDIT_API_KEY=
# Didit Console > Workflows (KYC + Liveness + Face Match)
DIDIT_WORKFLOW_ID=
# The webhook destination's secret_shared_key (shown only once when it is created)
DIDIT_WEBHOOK_SECRET=
# Workflow of type "Biometric Authentication". REQUIRED for staff face sign-in.
DIDIT_BIOMETRIC_WORKFLOW_ID=
DIDIT_BASE_URL=https://verification.didit.me
# sandbox | live.  MUST be 'live' in production (enforced at startup).
DIDIT_ENVIRONMENT=sandbox
# Optional, sandbox applications only. MUST be empty in production (live rejects it).
DIDIT_SANDBOX_SCENARIO=

# Verification attempts per user per window (provider errors don't count)
IDV_MAX_ATTEMPTS=3
IDV_ATTEMPT_WINDOW_HOURS=24
# `flask --app run idv-purge` removes non-verified records older than this many days
IDV_RETENTION_DAYS=365
IDV_POLL_COOLDOWN_SECONDS=15
IDV_HTTP_CONNECT_TIMEOUT=10
IDV_HTTP_READ_TIMEOUT=30
# Shown in the consent notice (your data-protection contact)
IDV_PRIVACY_CONTACT_EMAIL=

# Staff face sign-in limits
# Face checks one person may start per hour (limits cost abuse)
IDV_BIOMETRIC_MAX_PER_HOUR=6
IDV_BIOMETRIC_POLL_COOLDOWN_SECONDS=3
# Sign-in face-check records are deleted after this many days
IDV_BIOMETRIC_RETENTION_DAYS=90

# Didit Face Search similarity (0-100). Code default is 90; start lower (e.g. 80)
# while calibrating, then tighten. See docs/face_login_guide.md
FACE_LOGIN_MIN_SIMILARITY=80
FACE_LOGIN_MIN_MARGIN=5

# --- SMS notifications (UniSMS) ---------------------------------------------------
# Keep SMS_ENABLED=false until you have tested with your own phone number.
# With SMS_ENABLED=true and no key (or a non-https URL) the app refuses to start.
SMS_ENABLED=false
UNISMS_API_BASE_URL=https://unismsapi.com/api
# Your UniSMS API secret key (used as the Basic-auth username with an empty password).
UNISMS_API_SECRET_KEY=
UNISMS_SENDER_ID=Unisoft
SMS_CONNECT_TIMEOUT=3.05
SMS_READ_TIMEOUT=10

# --- File storage (optional) -------------------------------------------------------
# Folders for uploaded profile pictures and the payment QR image. Leave empty to use the
# built-in default (instance/uploads/...). On Render use a persistent disk path,
# otherwise uploads vanish on every redeploy.
PROFILE_AVATAR_DIR=
PAYMENT_UPLOAD_DIR=

# --- Optional: only for the live Didit sandbox integration test (tests/integration) --
# DIDIT_SANDBOX_API_KEY=
# DIDIT_SANDBOX_WORKFLOW_ID=
