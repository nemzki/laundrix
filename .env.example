# Copy this file to ".env" and fill in real values.  NEVER commit ".env".
# Generate SECRET_KEY with:  python -c "import secrets; print(secrets.token_hex(32))"
# Required to start the app: SECRET_KEY, DB_USER, DB_PASSWORD.  Everything else has a safe default.

# --- App ---
APP_ENV=development            # development | production
SECRET_KEY=
APP_BASE_URL=http://127.0.0.1:5000   # must be https://... in production
SESSION_LIFETIME_MINUTES=480
BEHIND_PROXY=false             # true if behind Nginx/Cloudflare/Render etc. (production)
RATELIMIT_STORAGE_URI=memory://  # use redis://localhost:6379 in production

# --- Database (MySQL / TiDB) ---
DB_HOST=localhost
DB_PORT=3306                   # TiDB Cloud uses 4000
DB_NAME=laundrix_db
DB_USER=
DB_PASSWORD=

# Optional database TLS (required for TiDB Cloud). Use a path that exists on THIS machine,
# e.g. Windows: C:\path\to\isrgrootx1.pem   |   Render: /etc/secrets/isrgrootx1.pem
DB_SSL_CA=
DB_SSL_VERIFY_CERT=true
DB_SSL_VERIFY_IDENTITY=true

# --- Google OAuth (admins) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAIN=         # optional: only allow Google accounts from this domain

# --- Administrator password sign-in ---
ADMIN_PASSWORD_LOGIN_ENABLED=true
# Used ONLY by `flask --app run bootstrap-admin` to create the first administrator (never at start-up).
# Remove INITIAL_ADMIN_PASSWORD from this file once it has been used.
# To give an EXISTING (Google) administrator a password instead, run:
#   flask --app run rotate-admin-password you@example.com
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_EMAIL=

# --- Staff Google sign-in ---
STAFF_GOOGLE_LOGIN_ALLOWED=true

# --- Staff account security and enrollment ---
STAFF_MAX_FAILED_ATTEMPTS=5
STAFF_LOCKOUT_MINUTES=15
STAFF_LOGIN_WINDOW_SECONDS=600
STAFF_ENROLL_TOKEN_HOURS=24

# --- Identity verification: government ID + liveness + face match (Didit hosted flow) ---
# OFF by default. Turn on only after you have created a Didit application + workflow.
# Setup guide: docs/identity_verification.md
IDV_ENABLED=false
IDV_PROVIDER=didit
DIDIT_API_KEY=                 # from Didit Console > API & Webhooks (keep secret; backend only)
DIDIT_WORKFLOW_ID=             # from Didit Console > Workflows
DIDIT_WEBHOOK_SECRET=          # the destination's secret_shared_key (shown once when created)
DIDIT_BIOMETRIC_WORKFLOW_ID=   # Workflow of type Biometric Authentication; REQUIRED for staff face sign-in
DIDIT_BASE_URL=https://verification.didit.me
DIDIT_ENVIRONMENT=sandbox      # sandbox | live  -> MUST be 'live' in production
DIDIT_SANDBOX_SCENARIO=        # optional, sandbox applications only (must NOT be set in production)
IDV_MAX_ATTEMPTS=3             # verification attempts per user per window (provider errors don't count)
IDV_ATTEMPT_WINDOW_HOURS=24
IDV_RETENTION_DAYS=365         # `flask idv-purge` removes non-verified records older than this
IDV_POLL_COOLDOWN_SECONDS=15
IDV_BIOMETRIC_MAX_PER_HOUR=6   # face checks one person may start per hour (limits cost abuse)
IDV_BIOMETRIC_POLL_COOLDOWN_SECONDS=3
IDV_BIOMETRIC_RETENTION_DAYS=90  # sign-in face-check records are deleted after this
IDV_HTTP_CONNECT_TIMEOUT=3.05
IDV_HTTP_READ_TIMEOUT=10
IDV_PRIVACY_CONTACT_EMAIL=     # shown in the consent notice (your data protection contact)

# Didit Face Search similarity (0-100). The code default is 90; start lower (e.g. 80) while
# calibrating, then tighten (see docs/face_login_guide.md)
FACE_LOGIN_MIN_SIMILARITY=80
FACE_LOGIN_MIN_MARGIN=5

# --- SMS Notifications (UniSMS) ---
# Keep SMS_ENABLED=false until you have tested with your own number. Never commit the real secret.
SMS_ENABLED=false
UNISMS_API_BASE_URL=https://unismsapi.com/api
# Your UniSMS API secret key (used as the Basic-auth username with an empty password).
UNISMS_API_SECRET_KEY=
UNISMS_SENDER_ID=Unisoft
SMS_CONNECT_TIMEOUT=3.05
SMS_READ_TIMEOUT=10

# --- File storage (optional) ---
# Folders for uploaded profile pictures and the payment QR image. Leave empty to use the built-in
# default inside the app. On Render use a persistent disk path, otherwise uploads vanish on redeploy.
PROFILE_AVATAR_DIR=
PAYMENT_UPLOAD_DIR=

# --- Optional: only for the live Didit sandbox integration test (tests/integration) ---
# DIDIT_SANDBOX_API_KEY=
# DIDIT_SANDBOX_WORKFLOW_ID=
