# Copy this file to ".env" and fill in real values.  NEVER commit ".env".
# Generate SECRET_KEY with:  python -c "import secrets; print(secrets.token_hex(32))"

# --- App ---
APP_ENV=development            # development | production
SECRET_KEY=
APP_BASE_URL=http://127.0.0.1:5000   # must be https://... in production
SESSION_LIFETIME_MINUTES=480
BEHIND_PROXY=false             # true if behind Nginx/Cloudflare etc. (production)
RATELIMIT_STORAGE_URI=memory://  # use redis://localhost:6379 in production

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=laundrix_db
DB_USER=
DB_PASSWORD=

# --- Google OAuth (admins) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAIN=
STAFF_GOOGLE_LOGIN_ALLOWED=false   # false = staff MUST use the Staff Portal (email + ID + face)

# --- Staff portal (email + Staff ID + face check by Didit Biometric Authentication) ---
STAFF_MAX_FAILED_ATTEMPTS=5
STAFF_LOCKOUT_MINUTES=15
STAFF_LOGIN_WINDOW_SECONDS=600
STAFF_ENROLL_TOKEN_HOURS=24

# --- Identity verification: government ID + liveness + face match (Didit hosted flow) ---
# OFF by default. Turn on only after you have created a Didit application + workflow.
# Setup guide: docs/identity_verification.md
IDV_ENABLED=false
IDV_PROVIDER=didit
DIDIT_API_KEY=                 # from Didit Console > API & Webhooks (keep secret; backend only)
DIDIT_WORKFLOW_ID=             # from Didit Console > Workflows
DIDIT_WEBHOOK_SECRET=          # the destination's secret_shared_key (shown once when created)
DIDIT_BIOMETRIC_WORKFLOW_ID=    # Workflow of type Biometric Authentication; REQUIRED for staff sign-in
DIDIT_BASE_URL=https://verification.didit.me
DIDIT_ENVIRONMENT=sandbox      # sandbox | live  -> MUST be 'live' in production
DIDIT_SANDBOX_SCENARIO=        # optional, sandbox applications only (live applications reject it)
IDV_MAX_ATTEMPTS=3             # verification attempts per user per window (provider errors don't count)
IDV_ATTEMPT_WINDOW_HOURS=24
IDV_RETENTION_DAYS=365         # `flask idv-purge` removes non-verified records older than this
IDV_POLL_COOLDOWN_SECONDS=15
IDV_BIOMETRIC_MAX_PER_HOUR=6    # face checks one person may start per hour (limits cost abuse)
IDV_BIOMETRIC_POLL_COOLDOWN_SECONDS=3
IDV_BIOMETRIC_RETENTION_DAYS=90  # sign-in face-check records are deleted after this
IDV_HTTP_CONNECT_TIMEOUT=3.05
IDV_HTTP_READ_TIMEOUT=10
IDV_PRIVACY_CONTACT_EMAIL=     # shown in the consent notice (your data protection contact)
