{
  "name": "laundrix-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test:e2e": "playwright test",
    "build:foundation": "tsc -b && vite build --config foundation.vite.config.ts",
    "preview:foundation": "vite preview --config foundation.vite.config.ts",
    "test:foundation": "playwright test --config playwright.foundation.config.ts",
    "build:prototype": "tsc -b && vite build --config prototype.vite.config.ts",
    "preview:prototype": "vite preview --config prototype.vite.config.ts",
    "test:prototype": "playwright test --config playwright.prototype.config.ts",
    "build:dashboard": "tsc -b && vite build --config dashboard.vite.config.ts",
    "test:dashboard": "playwright test --config playwright.dashboard.config.ts",
    "build:catalog": "tsc -b && vite build --config catalog.vite.config.ts",
    "build:staff": "tsc -b && vite build --config staff.vite.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^7.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.70.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "postcss": "^8.5.32",
    "postcss-prefix-selector": "^2.2.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
